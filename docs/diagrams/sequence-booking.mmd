---
config:
  theme: redux
---
sequenceDiagram
    actor User
    participant Server as JavaScript: server
    participant Router as Router: bookings
    participant Controller as Controller: bookings
    participant Model as Model: Hotel / Booking
    participant DB as MongoDB

    User->>Server: POST /api/v1/bookings
    Server->>Router: Route request
    Router->>Router: Verify JWT and role

    alt Unauthorized
        Router-->>User: 401 / 403 Unauthorized
    else Authorized
        Router->>Controller: addBooking(req, res)
        Controller->>Model: Hotel.findById(hotelId)
        Model->>DB: Find hotel
        DB-->>Model: Hotel data
        Model-->>Controller: Hotel result

        alt Invalid hotel
            Controller-->>User: 404 Hotel not found
        else Valid hotel
            Controller->>Model: Booking.create(bookingData)
            Model->>Model: Validate stay (1-3 nights)

            alt Invalid stay
                Model-->>Controller: ValidationError
                Controller-->>User: 400 Invalid booking dates
            else Valid stay
                Model->>DB: Insert booking
                DB-->>Model: Booking saved
                Model-->>Controller: Booking result
                Controller-->>User: 201 Booking created
            end
        end
    end